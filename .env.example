# ==========================================
# Application Configuration Template
# (Copy to .env for local runtime execution)
# ==========================================

NODE_ENV=production
PORT=8080

# Database Configuration (PostgreSQL Connection String)
# Leave empty to run with resilient high-speed in-memory engine
DATABASE_URL=postgresql://ecommerce_user:secure_production_password_2026@localhost:5432/ecommerce_db

# Security & Admin Access Key
ADMIN_API_KEY=algions-secret-key-2026
